# 复制为 deploy/qnap/.env 后使用。
# 下面的网络地址只是示例，请按你的 QNAP 和主路由实际情况修改。

TZ=Asia/Shanghai

# 稳定版镜像。升级版本时只改这里即可。
OPENSURGE_IMAGE=zyk1172/opensurge-for-qnap:1.0.0
# 本地没有该镜像时才拉取。
OPENSURGE_PULL_POLICY=missing

# 仅源码本地构建时使用，普通部署不用改。
OPENSURGE_VERSION=dev

# OpenSurge 在局域网中的固定 IPv4。
# 建议放在主路由 DHCP 自动分配范围之外，或在主路由中做固定保留。
OPENSURGE_IP=192.168.2.241

# 局域网网段。
OPENSURGE_SUBNET=192.168.2.0/24

# 主路由 IPv4。
OPENSURGE_GATEWAY=192.168.2.1

# QNAP 上 OpenSurge 实际使用的物理网卡或 Virtual Switch。
# 双网卡 NAS 不要只凭 eth0 / eth1 猜，先运行：
#   sh ./preflight.sh --list-interfaces
# 再结合 QTS「网络与虚拟交换机」确认。
OPENSURGE_PARENT_INTERFACE=eth1

# 容器内部网卡。正常单 QNET 部署通常保持 eth0，不要改。
OPENSURGE_CONTAINER_INTERFACE=eth0

# 持久化目录。账户、配置、订阅和恢复状态都保存在这里。
# 必须使用 QNAP 上的绝对路径，不要在正式部署中写 ./data。
OPENSURGE_DATA_PATH=/share/Container/opensurge

# Web 进程使用的 UID/GID，需要对上面的持久化目录有写权限。
# 在 QNAP 上运行 `id <用户名>` 查看实际数字，不要直接照抄示例。
OPENSURGE_WEB_UID=1000
OPENSURGE_WEB_GID=100

# Docker 日志大小限制，一般无需修改。
OPENSURGE_LOG_MAX_SIZE=10m
OPENSURGE_LOG_MAX_FILES=3

# 可选：如果通过局域网反向代理域名访问 Web，可填允许的域名，逗号分隔。
# 直接使用 http://OpenSurge-IP:8080 时留空即可。
OPENSURGE_ALLOWED_HOSTS=

# 直接通过局域网 HTTP 访问时保持 false。
# 只有确定通过 HTTPS 反向代理访问时才改成 true。
OPENSURGE_SECURE_COOKIES=false
