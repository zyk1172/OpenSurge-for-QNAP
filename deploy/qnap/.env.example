# Copy this file to deploy/qnap/.env and replace every network value after
# checking QNAP Network & Virtual Switch. The values below are examples only.

OPENSURGE_VERSION=dev
TZ=Asia/Shanghai

# Static LAN identity for the OpenSurge container. Keep the IP outside the
# router's dynamic DHCP pool or reserve it on the router.
OPENSURGE_IP=192.168.2.241
OPENSURGE_SUBNET=192.168.2.0/24
OPENSURGE_GATEWAY=192.168.2.1

# QNAP HOST-SIDE QNET parent interface. This is the setting that selects which
# NAS NIC / bridge OpenSurge uses on a dual-NIC NAS. Examples: eth0, eth1, br0.
# Run `sh ./preflight.sh --list-interfaces` and confirm the adapter in QNAP
# Network & Virtual Switch before choosing it.
OPENSURGE_PARENT_INTERFACE=eth1

# Container-side interface. With the supported single-QNET-network topology it
# is normally eth0 even when the QNAP parent above is eth1/br0. Do not confuse
# this with OPENSURGE_PARENT_INTERFACE.
OPENSURGE_CONTAINER_INTERFACE=eth0

# Persistent host path mounted as /data. Use a dedicated ABSOLUTE QNAP shared-
# folder subdirectory; do not use ./data for a real NAS deployment.
# The entire /data tree is intentionally persisted because crash-recovery state
# must survive container recreation as well as user configuration.
OPENSURGE_DATA_PATH=/share/Container/opensurge

# Docker json-file log rotation. Keep this bounded on a NAS so an unexpected
# noisy loop cannot consume the storage pool.
OPENSURGE_LOG_MAX_SIZE=10m
OPENSURGE_LOG_MAX_FILES=3

# Optional comma-separated DNS names used to access the Web UI through a LAN
# reverse proxy, e.g. opensurge.home.arpa. Private IPv4/IPv6 literal hosts are
# accepted automatically.
OPENSURGE_ALLOWED_HOSTS=

# Keep false for direct http://LAN-IP:8080 access. Set true only when users
# reach OpenSurge through an HTTPS reverse proxy; session cookies then carry
# Secure and the Web gateway emits HSTS.
OPENSURGE_SECURE_COOKIES=false
