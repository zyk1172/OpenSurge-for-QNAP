# Copy to deploy/qnap/.env and replace every network value after checking
# QNAP Network & Virtual Switch. The values below are examples only.

OPENSURGE_VERSION=dev
TZ=Asia/Shanghai

# A free LAN address for the OpenSurge container. Keep it outside the router's
# dynamic DHCP pool or reserve it on the router.
OPENSURGE_IP=192.168.2.241
OPENSURGE_SUBNET=192.168.2.0/24
OPENSURGE_GATEWAY=192.168.2.1

# Linux/QNAP parent interface carrying that LAN. This may be a physical NIC,
# bond or QNAP virtual-switch interface. Verify it on the NAS; do not assume
# the example name is correct.
OPENSURGE_PARENT_INTERFACE=eth0

# Persistent host path. Prefer a dedicated share/subdirectory that is included
# in your normal QNAP backup policy.
OPENSURGE_DATA_PATH=./data

# Optional comma-separated DNS names used to access the Web UI through a LAN
# reverse proxy, e.g. opensurge.home.arpa. Private IPv4/IPv6 literal hosts are
# accepted automatically.
OPENSURGE_ALLOWED_HOSTS=
