# Copy the selected example to .env. All addresses and identities must be verified.
TZ=Asia/Shanghai
# Historical image repository name; the same NEWLY BUILT image supports all NAS profiles.
# Older images do not include runtime platform metadata. Prefer a release containing this change.
OPENSURGE_IMAGE=opensurge-for-qnap:test
OPENSURGE_PULL_POLICY=never
OPENSURGE_NAS_PLATFORM=fnos
OPENSURGE_IP=192.168.2.241
OPENSURGE_SUBNET=192.168.2.0/24
OPENSURGE_GATEWAY=192.168.2.1
# Example only: run sh ./preflight.sh --list-interfaces and inspect the LAN route.
OPENSURGE_PARENT_INTERFACE=enp1s0
OPENSURGE_CONTAINER_INTERFACE=eth0
# Dedicated directory, outside the Compose project directory. Never point to a share root.
OPENSURGE_DATA_PATH=/vol1/1000/docker/opensurge-data
# Run id <NAS-user>; do not assume these example values match your account.
OPENSURGE_WEB_UID=1000
OPENSURGE_WEB_GID=100
OPENSURGE_ALLOWED_HOSTS=
OPENSURGE_SECURE_COOKIES=false
OPENSURGE_LOG_MAX_SIZE=10m
OPENSURGE_LOG_MAX_FILES=3

# Default local Web requires no credentials.
OPENSURGE_WEB_AUTH=false
